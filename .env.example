PORT=3000

# Required — get a key at https://duffel.com
DUFFEL_API_KEY=

# Optional — subscriptions require both database values and all SMTP values below
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enable price alerts only when the database and SMTP delivery are configured
SUBSCRIPTIONS_ENABLED=false

# Optional — alerts stay disabled until all four values are set; messages are never logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — required only to call POST /api/jobs/check-subscriptions
JOB_SECRET=
