<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="description" content="" />
  <meta name="author" content="" />
  <title>Atlantis</title>
  <link rel="icon" type="image/x-icon" href="public/assets/favicon.ico" />
  <script src="https://use.fontawesome.com/releases/v6.1.0/js/all.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css?family=Catamaran:100,200,300,400,500,600,700,800,900" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css?family=Lato:100,100i,300,300i,400,400i,700,700i,900,900i"
    rel="stylesheet" />
  <link href="public/css/styles.css" rel="stylesheet" type="text/css" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="http://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
</head>

<!-- Header -->

<body id="page-top">
  <!-- SCRIPT: Populating Dropdowns -->
  <script type="text/javascript">
    var options = "<%= options %>".split(",");
    var datalistFrom = document.getElementById("airports-from");
    var datalistTo = document.getElementById("airports-to");

    options.forEach(function (item) {
      var option = document.createElement('option');
      option.value = item;
      datalistFrom.appendChild(option);
    });
    options.forEach(function (item) {
      var option = document.createElement('option');
      option.value = item;
      datalistTo.appendChild(option);
    });
  </script>

  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom fixed-top">
    <div class="container px-5 justify-content-center">
      <a class="navbar-brand" href="#page-top">Atlantis</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive"
        aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
  </nav>

  <!-- Start Image -->
  <header class="masthead text-center text-white">
    <div class="masthead-content">
      <div class="container px-5">
        <h1 class="masthead-heading mb-0">Try Atlantis</h1>
        <h2 class="masthead-subheading mb-0">Take the cheaper route</h2>
        <a class="btn btn-primary btn-xl rounded-pill mt-5" href="#scroll">Book Now</a>
      </div>
    </div>
    <div class="bg-circle-1 bg-circle"></div>
    <div class="bg-circle-2 bg-circle"></div>
    <div class="bg-circle-3 bg-circle"></div>
    <div class="bg-circle-4 bg-circle"></div>
  </header>

  <!-- Route Filter -->
  <section id="scroll">
    <div class="container px-5">
      <div class="wrapper bg-white">
        <form action="/search" method="post" id="myForm">
          <div class="form-group d-sm-flex margin">
            <div class="d-flex align-items-center flex-fill me-sm-1 my-sm-0 my-4 border-bottom position-relative">
              <input name="orig" type="text" required placeholder="From" class="form-control" list="airports-from" />
              <datalist id="airports-from"></datalist>
              <div class="label" id="from"></div>
              <span class="fas fa-dot-circle text-muted"></span>
            </div>
            <div class="d-flex align-items-center flex-fill ms-sm-1 my-sm-0 my-4 border-bottom position-relative">
              <input name="dest" type="text" required placeholder="To" class="form-control" list="airports-to" />
              <datalist id="airports-to"></datalist>
              <div class="label" id="to"></div>
              <span class="fas fa-map-marker text-muted"></span>
            </div>
          </div>
          <div class="form-group d-sm-flex margin">
            <div class="d-flex align-items-center flex-fill me-sm1 my-sm-0 border-bottom position-relative">
              <input type="date" required placeholder="Depart Date" class="form-control" name="dep_date" />
              <div class="label" id="depart"></div>
            </div>
            <div class="d-flex align-items-center flex-fill ms-sm-1 my-sm-0 my-4 border-bottom position-relative">
              <input type="date" placeholder="Return Date" class="form-control" name="ret_date" />
              <div class="label" id="return"></div>
            </div>
          </div>
          <div class="form-group align-items-center margin d-flex border-bottom position-relative">
            <input type="text" required placeholder="Traveler(s)" class="form-control" name="num_adults" />
            <div class="label" id="psngr"></div>
            <span class="fas fa-users text-muted"></span>
          </div>
          <div class="form-group my-3 button-wrapper">
            <button class="btn btn-primary rounded-0 d-flex justify-content-center text-center p-3"
              onclick="this.disabled=true;this.value='Searching...'; this.form.submit(); document.getElementById('contents').style.visibility='visible';">Search
              Flights</button>
          </div>
        </form>
      </div>
      <body>
        <div id="contents" style="visibility:hidden" class="h-100 d-flex align-items-center justify-content-center">
          <img src="https://discuss.wxpython.org/uploads/default/original/2X/6/6d0ec30d8b8f77ab999f765edd8866e8a97d59a3.gif">
        </div>
    </body>
    </div>
  </section>

  <!-- Results Table -->
  <section>
    <div class="container px-5">
      <!-- Departures -->
      <% if(data[0].length > 0){ %>
        <h3>Departures to <%= dest %> on <%= dep_date %>
        </h3>
        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="table-responsive">
                <table class="table">
                  <thead class="thead-light">
                    <tr>
                      <th scope="col">Airline</th>
                      <th scope="col">Path</th>
                      <th scope="col">Departure (Local Time)</th>
                      <th scope="col">Arrival (Local Time)</th>
                      <th scope="col">Price</th>
                    </tr>
                  </thead>
                  <tbody class="customtable">
                    <tr style="background-color: #d6d3c9;">
                      <td>
                        <%= data[0][0].airline %>
                      </td>
                      <td>
                        <%= data[0][0].path %>
                      </td>
                      <td>
                        <%= data[0][0].departureTime %>
                      </td>
                      <td>
                        <%= data[0][0].arrivalTime %>
                      </td>
                      <td>
                        <a href="<%= data[0][0].bookingLink %>">
                          <%= data[0][0].price %>
                        </a>
                      </td>
                    </tr>
                    <% for (var i=1; i < data[0].length; i++) { %>
                      <tr>
                        <td>
                          <%= data[0][i].airline %>
                        </td>
                        <td>
                          <%= data[0][i].path %>
                        </td>
                        <td>
                          <%= data[0][i].departureTime %>
                        </td>
                        <td>
                          <%= data[0][i].arrivalTime %>
                        </td>
                        <td>
                          <a href="<%= data[0][i].bookingLink %>">
                            <%= data[0][i].price %>
                          </a>
                        </td>
                      </tr>
                      <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <% } %>

          <!-- Returns -->
          <% if(data[1].length> 0){ %>
            <h3>Returns to <%= orig %> on <%= ret_date %>
            </h3>
            <div class=" row">
              <div class="col-12">
                <div class="card">
                  <div class="table-responsive">
                    <table class="table">
                      <thead class="thead-light">
                        <tr>
                          <th scope="col">Airline</th>
                          <th scope="col">Path</th>
                          <th scope="col">Departure (Local Time)</th>
                          <th scope="col">Arrival (Local Time)</th>
                          <th scope="col">Price</th>
                        </tr>
                      </thead>
                      <tbody class="customtable">
                        <tr style="background-color: #d6d3c9;">
                          <td>
                            <%= data[1][0].airline %>
                          </td>
                          <td>
                            <%= data[1][0].path %>
                          </td>
                          <td>
                            <%= data[1][0].departureTime %>
                          </td>
                          <td>
                            <%= data[1][0].arrivalTime %>
                          </td>
                          <td>
                            <a href="<%= data[1][0].bookingLink %>">
                              <%= data[1][0].price %>
                            </a>
                          </td>
                        </tr>
                        <% for (var i=1; i < data[1].length; i++) { %>
                          <tr>
                            <td>
                              <%= data[1][i].airline %>
                            </td>
                            <td>
                              <%= data[1][i].path %>
                            </td>
                            <td>
                              <%= data[1][i].departureTime %>
                            </td>
                            <td>
                              <%= data[1][i].arrivalTime %>
                            </td>
                            <td>
                              <a href="<%= data[1][i].bookingLink %>">
                                <%= data[1][i].price %>
                              </a>
                            </td>
                          </tr>
                          <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            <% } %>

              <% if (data[0].length> 0 || data[1].length > 0) { %>
                <h3>Text Notify</h3>
                <div class="form-group border-bottom d-flex align-items-center margin position-relative">
                  <input id="inputNameField" type="text" required placeholder="Name" class="form-control" name="name" />
                  <div class="label" id="name"></div>
                  <span class="fas fa-person text-muted" style="padding-left: 10px"></span>
                </div>
                <div class="form-group border-bottom d-flex align-items-center margin position-relative">
                  <input type="text" id="inputNumberField" required placeholder="Phone Number" class="form-control"
                    name="phone_number" />
                  <div class="label" id="nmbr"></div>
                  <span class="fas fa-phone text-muted" style="padding-left: 10px"></span>
                </div>
                <div class="form-group border-bottom d-flex align-items-center position-relative">
                  <input type="text" id="inputPriceField" required placeholder="Price Threshold ($)"
                    class="form-control" name="price_threshold" />
                  <div class="label" id="prc"></div>
                  <span class="fas fa-dollar text-muted" style="padding-left: 10px"></span>
                </div>

                <div class="form-group my-3 button-wrapper">
                  <button class="btn btn-primary rounded-0 d-flex justify-content-center text-center p-3"
                    id="ajaxSubmit"> Subscribe </button>
                  <script>
                    var inputNameField = document.getElementById('inputNameField');
                    var inputNumberField = document.getElementById('inputNumberField');
                    var inputPriceField = document.getElementById('inputPriceField');
                    $("#ajaxSubmit").click(function () {
                      var inputNameText = inputNameField.value;
                      var inputNumberText = inputNumberField.value;
                      var inputPriceText = inputPriceField.value;
                      console.log(/^\+\d{1}-\d{3}-\d{3}-\d{4}$/.test(inputNumberText));
                      if (inputNameText.length < 1) {
                        alert("Name is not in the correct format - please provide a valid text input.");
                      } else if (!/^\+\d{1}-\d{3}-\d{3}-\d{4}$/.test(inputNumberText)) {
                        alert("Phone Number is not in the correct format - please provide a valid US number in the format +1-123-456-7890.");
                      } else if (inputPriceText.length < 1 || inputPriceText.match(/[^.\d]/)) {
                        alert("Price is not in the correct format - please provide a valid, numerical and integral input.");
                      } else {
                        $("#ajaxSubmit").attr("disabled", true);
                        $.ajax({
                          type: "POST",
                          url: "/subscribe",
                          data: {
                            name: inputNameText,
                            phone_number: inputNumberText,
                            price_threshold: inputPriceText,
                          },
                          success: function (result) { alert("Subscription success!") },
                          error: function (result) { alert("Subscription error..."); }
                        });
                      }
                    });
                  </script>
                </div>
                <% } %>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-5 bg-black">
    <div class="container px-5">
      <p class="m-0 text-center text-white small">
        Copyright &copy; Atlantis 2023
      </p>
    </div>
  </footer>
</body>

</html>