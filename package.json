  "bugs": {
    "url": "https://github.com/kjaisingh/atlantis/issues"
  },
  "homepage": "https://github.com/kjaisingh/atlantis#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.7.7",
    "compression": "^1.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.2"
  }
}
