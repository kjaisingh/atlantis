PORT=3000

# Required — get a key at https://duffel.com
DUFFEL_API_KEY=

# Optional — subscriptions are disabled until both are set. Free tier at https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — email notifications fall back to console logging until all four are set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — required only to call POST /api/jobs/check-subscriptions
JOB_SECRET=
