{
  "name": "atlantis",
  "version": "1.0.0",
  "description": "Hidden-city flight search: find itineraries where your real destination is a cheaper layover",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "check": "npm run format:check && npm run lint && npm run validate:data && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test server/*.test.js && python3 scripts/test-routes.py",
    "test:e2e": "npm run build && node scripts/smoke-test.mjs",
    "test:db": "node scripts/test-database.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjaisingh/atlantis.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kjaisingh/atlantis/issues"
  },
  "homepage": "https://github.com/kjaisingh/atlantis#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
